{
  "expo": {
    "name": "Open Nutrition",
    "slug": "open-nutrition",
    "scheme": "opennutrition",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f5f6f3",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.opennutrition.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.opennutrition.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#127a52",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-system-ui",
      [
        "expo-camera",
        {
          "cameraPermission": "Open Nutrition uses the camera to scan food barcodes and, if you turn on AI logging, to photograph meals.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Open Nutrition lets you pick a meal photo for AI logging. Photos are only sent when you ask for an estimate.",
          "cameraPermission": "Open Nutrition uses the camera to scan food barcodes and, if you turn on AI logging, to photograph meals.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-sharing",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#127a52",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#127a52"
          }
        }
      ]
    ]
  }
}
